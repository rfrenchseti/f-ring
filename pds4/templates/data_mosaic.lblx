<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="$PDS4_PDS_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="$PDS4_RINGS_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="$PDS4_DISP_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="$PDS4_CASSINI_SCHEMA$"
schematypens="http://purl.oclc.org/dsdl/schematron"?>

<Product_Observational
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:disp="http://pds.nasa.gov/pds4/disp/v1"
    xmlns:rings="http://pds.nasa.gov/pds4/rings/v1"
    xmlns:cassini="http://pds.nasa.gov/pds4/mission/cassini/v1"
    xsi:schemaLocation="
	http://pds.nasa.gov/pds4/pds/v1 $PDS4_PDS_SCHEMA$
	http://pds.nasa.gov/pds4/rings/v1 $PDS4_RINGS_SCHEMA$">

    <Identification_Area>
        <logical_identifier>$MOSAIC_LID$</logical_identifier>
        <version_id>1.0</version_id>
        <title>
            $WRAP(12,91,MOSAIC_TITLE,preserve_single_newlines=False)$
        </title>
        <information_model_version>$INFORMATION_MODEL_VERSION$</information_model_version>
        <product_class>Product_Observational</product_class>
        <Citation_Information>
            <publication_year>$PUBLICATION_YEAR$</publication_year>
            $FOR(KEYWORD=KEYWORDS)
            <keyword>$KEYWORD$</keyword>
            $END_FOR
            <keyword>mosaic</keyword>
            <description>
                $WRAP(16,91,MOSAIC_DESCRIPTION,preserve_single_newlines=False)$
            </description>
            <List_Author>
                <Person>
                    <display_full_name>Robert S. French</display_full_name>
                    <given_name>Robert</given_name>
                    <family_name>French</family_name>
                    <person_orcid>https://orcid.org/0000-0002-9527-7920</person_orcid>
                    <sequence_number>1</sequence_number>
                    <Affiliation>
                        <organization_name>SETI Institute</organization_name>
                        <organization_rorid>https://ror.org/02dxgk712</organization_rorid>
                        <sequence_number>1</sequence_number>
                    </Affiliation>
                </Person>
                <Person>
                    <display_full_name>Matthew M. Hedman</display_full_name>
                    <given_name>Matthew</given_name>
                    <family_name>Hedman</family_name>
                    <person_orcid>http://orcid.org/0000-0002-8592-0812</person_orcid>
                    <sequence_number>2</sequence_number>
                    <Affiliation>
                        <organization_name>University of Idaho</organization_name>
                        <organization_rorid>https://ror.org/03hbp5t65</organization_rorid>
                        <sequence_number>1</sequence_number>
                    </Affiliation>
                </Person>
            </List_Author>
            <List_Contributor>
                <Person>
                    <contributor_type>DataCurator</contributor_type>
                    <display_full_name>Mia J.T. Mace</display_full_name>
                    <given_name>Mia</given_name>
                    <family_name>Mace</family_name>
                    <person_orcid>https://orcid.org/0000-0002-9905-816X</person_orcid>
                    <sequence_number>1</sequence_number>
                    <Affiliation>
                        <organization_name>NASA's Planetary Data System (Ring-Moon Systems Node)</organization_name>
                        <organization_rorid>https://ror.org/006ndaj41</organization_rorid>
                        <sequence_number>1</sequence_number>
                    </Affiliation>
                    <Affiliation>
                        <organization_name>SETI Institute</organization_name>
                        <organization_rorid>https://ror.org/02dxgk712</organization_rorid>
                        <sequence_number>2</sequence_number>
                    </Affiliation>
                </Person>
                <Person>
                    <contributor_type>DataCurator</contributor_type>
                    <display_full_name>Mitchell K. Gordon</display_full_name>
                    <given_name>Mitchell</given_name>
                    <family_name>Gordon</family_name>
                    <person_orcid>https://orcid.org/0000-0003-0985-2800</person_orcid>
                    <sequence_number>2</sequence_number>
                    <Affiliation>
                        <organization_name>NASA's Planetary Data System (Ring-Moon Systems Node)</organization_name>
                        <organization_rorid>https://ror.org/006ndaj41</organization_rorid>
                        <sequence_number>1</sequence_number>
                    </Affiliation>
                    <Affiliation>
                        <organization_name>SETI Institute</organization_name>
                        <organization_rorid>https://ror.org/02dxgk712</organization_rorid>
                        <sequence_number>2</sequence_number>
                    </Affiliation>
                </Person>
                <Person>
                    <contributor_type>DataCurator</contributor_type>
                    <display_full_name>Matthew S. Tiscareno</display_full_name>
                    <given_name>Matthew</given_name>
                    <family_name>Tiscareno</family_name>
                    <person_orcid>https://orcid.org/0000-0002-2736-3667</person_orcid>
                    <sequence_number>2</sequence_number>
                    <Affiliation>
                        <organization_name>NASA's Planetary Data System (Ring-Moon Systems Node)</organization_name>
                        <organization_rorid>https://ror.org/006ndaj41</organization_rorid>
                        <sequence_number>1</sequence_number>
                    </Affiliation>
                    <Affiliation>
                        <organization_name>SETI Institute</organization_name>
                        <organization_rorid>https://ror.org/02dxgk712</organization_rorid>
                        <sequence_number>2</sequence_number>
                    </Affiliation>
                </Person>
                <Person>
                    <contributor_type>DataCurator</contributor_type>
                    <display_full_name>Emilie R. Simpson</display_full_name>
                    <given_name>Emilie</given_name>
                    <family_name>Simpson</family_name>
                    <person_orcid>https://orcid.org/0000-0003-0447-9867</person_orcid>
                    <sequence_number>2</sequence_number>
                    <Affiliation>
                        <organization_name>NASA's Planetary Data System (Ring-Moon Systems Node)</organization_name>
                        <organization_rorid>https://ror.org/006ndaj41</organization_rorid>
                        <sequence_number>1</sequence_number>
                    </Affiliation>
                    <Affiliation>
                        <organization_name>SETI Institute</organization_name>
                        <organization_rorid>https://ror.org/02dxgk712</organization_rorid>
                        <sequence_number>2</sequence_number>
                    </Affiliation>
                </Person>
            </List_Contributor>
        </Citation_Information>
        <Modification_History>
            <Modification_Detail>
                <modification_date>$CURRENT_ZULU(date_only=True)$</modification_date>
                <version_id>1.0</version_id>
                <description>Initial version.</description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>
    <Observation_Area>
        <comment>
            $WRAP(12,91,MOSAIC_COMMENT,preserve_single_newlines=False)$
        </comment>
        <Time_Coordinates>
            <start_date_time>$START_DATE_TIME$</start_date_time>
            <stop_date_time>$STOP_DATE_TIME$</stop_date_time>
        </Time_Coordinates>
        <Primary_Result_Summary>
            <purpose>Science</purpose>
            <processing_level>Derived</processing_level>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <discipline_name>Ring-Moon Systems</discipline_name>
            </Science_Facets>
        </Primary_Result_Summary>
        <Investigation_Area>
            <name>Cassini-Huygens</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:investigation:mission.cassini-huygens</lid_reference>
                <reference_type>data_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>
        <Observing_System>
            <name>Cassini Orbiter Imaging Science Subsystem - $CAMERA_WIDTH$ Angle Camera</name>
            <Observing_System_Component>
                <name>Cassini Orbiter</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument_host:spacecraft.co</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
            <Observing_System_Component>
                <name>Imaging Science Subsystem - $CAMERA_WIDTH$ Angle</name>
                <type>Instrument</type>
                <description>ISS$CAMERA_WN_UC$A</description>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument:iss$CAMERA_WN_LC$a.co</lid_reference>
                    <reference_type>is_instrument</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
        </Observing_System>
        <Target_Identification>
            <name>F Ring of Saturn</name>
            <type>Ring</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:target:ring.saturn.f_ring</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>
        <Target_Identification>
            <name>Saturn Rings</name>
            <type>Ring</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:target:ring.saturn.rings</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>$NOESCAPE(TARGET_IDENTIFICATION)$
        <Mission_Area>
            <cassini:Cassini>
                <cassini:ISS_Specific_Attributes>
                    <cassini:mission_phase_name>$TOUR$</cassini:mission_phase_name>
                    <cassini:spacecraft_clock_count_partition>1</cassini:spacecraft_clock_count_partition>
                    <cassini:spacecraft_clock_start_count>$SPACECRAFT_CLOCK_START_COUNT$</cassini:spacecraft_clock_start_count>
                    <cassini:spacecraft_clock_stop_count>$SPACECRAFT_CLOCK_STOP_COUNT$</cassini:spacecraft_clock_stop_count>
                    <cassini:filter_name_1>$FILTER1$</cassini:filter_name_1>
                    <cassini:filter_name_2>$FILTER2$</cassini:filter_name_2>
                    <cassini:observation_id>$OBSERVATION_ID$</cassini:observation_id>
                </cassini:ISS_Specific_Attributes>
            </cassini:Cassini>
        </Mission_Area>
        <Discipline_Area>
            <disp:Display_Settings>
                <Local_Internal_Reference>
                    <local_identifier_reference>mosaic</local_identifier_reference>
                    <local_reference_type>display_settings_to_array</local_reference_type>
                </Local_Internal_Reference>
                <disp:Display_Direction>
                    <disp:horizontal_display_axis>Sample</disp:horizontal_display_axis>
                    <disp:horizontal_display_direction>Left to Right</disp:horizontal_display_direction>
                    <disp:vertical_display_axis>Line</disp:vertical_display_axis>
                    <disp:vertical_display_direction>Top to Bottom</disp:vertical_display_direction>
                </disp:Display_Direction>
            </disp:Display_Settings>
            <rings:Ring_Moon_Systems>
                <rings:Ring_Reprojection>
                    <Local_Internal_Reference>
                        <local_identifier_reference>mosaic</local_identifier_reference>
                        <local_reference_type>reprojection_to_array</local_reference_type>
                    </Local_Internal_Reference>
                    <rings:Reprojection_Geometry>
                        <local_identifier>reproj_geom</local_identifier>
                        <rings:description>
                            $WRAP(28,91,MOSAIC_RINGS_DESCRIPTION,preserve_single_newlines=False)$
                        </rings:description>
                        <rings:epoch_reprojection_basis_utc>2007-01-01T00:00:00.000Z</rings:epoch_reprojection_basis_utc>
                        <rings:reprojection_plane>Equator</rings:reprojection_plane>
                        <rings:corotating_flag>Y</rings:corotating_flag>
                        <rings:corotation_rate unit="deg/s">0.006735694444</rings:corotation_rate> <!-- 581.964 deg/day -->
                        <rings:mean_phase_angle unit="deg">$MEAN_PHASE_ANGLE$</rings:mean_phase_angle>
                        <rings:minimum_phase_angle unit="deg">$MIN_PHASE_ANGLE$</rings:minimum_phase_angle>
                        <rings:maximum_phase_angle unit="deg">$MAX_PHASE_ANGLE$</rings:maximum_phase_angle>
                        <rings:mean_observed_ring_elevation unit="deg">$MEAN_OBS_RING_ELEV$</rings:mean_observed_ring_elevation>
                        <rings:minimum_observed_ring_elevation unit="deg">$MIN_OBS_RING_ELEV$</rings:minimum_observed_ring_elevation>
                        <rings:maximum_observed_ring_elevation unit="deg">$MAX_OBS_RING_ELEV$</rings:maximum_observed_ring_elevation>
                        <rings:minimum_corotating_ring_longitude unit="deg">$MIN_RING_COROTATING_LONG$</rings:minimum_corotating_ring_longitude>
                        <rings:maximum_corotating_ring_longitude unit="deg">$MAX_RING_COROTATING_LONG$</rings:maximum_corotating_ring_longitude>
                        <rings:minimum_ring_radius unit="km">$MIN_RING_RADIUS$</rings:minimum_ring_radius>
                        <rings:maximum_ring_radius unit="km">$MAX_RING_RADIUS$</rings:maximum_ring_radius>
                        <rings:Reprojection_Grid_Parameters>
                            <local_identifier>reproj_grid</local_identifier>
                            <rings:reprojection_grid_radial_sampling_interval unit="km">5.0</rings:reprojection_grid_radial_sampling_interval>
                            <rings:reprojection_grid_longitudinal_sampling_interval unit="deg">0.02</rings:reprojection_grid_longitudinal_sampling_interval>
                            <rings:minimum_radial_resolution unit="km">$MIN_REPROJ_GRID_RAD_RES$</rings:minimum_radial_resolution>
                            <rings:maximum_radial_resolution unit="km">$MAX_REPROJ_GRID_RAD_RES$</rings:maximum_radial_resolution>
                            <rings:mean_radial_resolution unit="km">$MEAN_REPROJ_GRID_RAD_RES$</rings:mean_radial_resolution>
                            <rings:minimum_longitudinal_resolution unit="deg">$MIN_REPROJ_GRID_ANG_RES$</rings:minimum_longitudinal_resolution>
                            <rings:maximum_longitudinal_resolution unit="deg">$MAX_REPROJ_GRID_ANG_RES$</rings:maximum_longitudinal_resolution>
                            <rings:mean_longitudinal_resolution unit="deg">$MEAN_REPROJ_GRID_ANG_RES$</rings:mean_longitudinal_resolution>
                        </rings:Reprojection_Grid_Parameters>
                    </rings:Reprojection_Geometry>
                </rings:Ring_Reprojection>
            </rings:Ring_Moon_Systems>
        </Discipline_Area>
    </Observation_Area>
    <Reference_List>
        <Internal_Reference>
            <lid_reference>$USERGUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>
                $WRAP(16,91,USERGUIDE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$CASSINI_USER_GUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>$CASSINI_USER_GUIDE_DESC$</comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$MOSAIC_METADATA_LID$</lid_reference>
            <reference_type>data_to_ancillary_data</reference_type>
            <comment>
                The mosaic metadata consists of two files, one containing a mapping of image index
                numbers to LIDs, the other containing metadata parameters indexed by co-rotating
                longitude.
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$MOSAIC_OTHER_LID$</lid_reference>
            <reference_type>data_to_derived_product</reference_type>
            <comment>
                $WRAP(16,91,MOSAIC_OTHER_REFERENCE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$BROWSE_MOSAIC_LID$</lid_reference>
            <reference_type>data_to_browse</reference_type>
            <comment>
                $WRAP(16,91,BROWSE_MOSAIC_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
    </Reference_List>
    <File_Area_Observational>
        <File>
            <file_name>$MOSAIC_IMG_FILENAME$</file_name>
            <creation_date_time>$CURRENT_ZULU()$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(IMG_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(IMG_PATH)$</md5_checksum>
        </File>
        <!-- The mosaic -->
        <Array_2D_Image>
            <local_identifier>mosaic</local_identifier>
            <offset unit="byte">0</offset>
            <axes>2</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <Element_Array>
                <data_type>IEEE754LSBSingle</data_type>
                <unit>I/F</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Line</axis_name> <!-- vertical (radial) -->
                <elements>$IMG_NUM_LINES$</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name> <!-- horizontal (longitude) -->
                <elements>$IMG_NUM_SAMPLES$</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Special_Constants>
                <!-- Data was missing or corrupted in the original image (either because it was off
                 the edge of the FOV or because of a transmission error resulting in a partial or
                 corrupted image) -->
                <missing_constant>$SENTINEL$</missing_constant>
            </Special_Constants>
        </Array_2D_Image>
    </File_Area_Observational>
</Product_Observational>
