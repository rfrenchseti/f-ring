<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="$PDS4_PDS_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="$PDS4_RINGS_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="$PDS4_DISP_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="$PDS4_CASSINI_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>

<Product_Observational
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:rings="http://pds.nasa.gov/pds4/rings/v1"
    xmlns:disp="http://pds.nasa.gov/pds4/disp/v1"
    xmlns:cassini="http://pds.nasa.gov/pds4/mission/cassini/v1"
    xsi:schemaLocation="
	http://pds.nasa.gov/pds4/pds/v1 $PDS4_PDS_SCHEMA_XSD$
	http://pds.nasa.gov/pds4/rings/v1 $PDS4_RINGS_SCHEMA_XSD$
    http://pds.nasa.gov/pds4/disp/v1 $PDS4_DISP_SCHEMA_XSD$
	http://pds.nasa.gov/pds4/mission/cassini/v1 $PDS4_CASSINI_SCHEMA_XSD$">

    <Identification_Area>
        <logical_identifier>$MOSAIC_LID$</logical_identifier>
        <version_id>1.0</version_id>
        <title>
            $WRAP(12,91,MOSAIC_TITLE,preserve_single_newlines=False)$
        </title>
        <information_model_version>$INFORMATION_MODEL_VERSION$</information_model_version>
        <product_class>Product_Observational</product_class>
        <Citation_Information>
            <publication_year>$PUBLICATION_YEAR$</publication_year>
            $FOR(KEYWORD=KEYWORDS_MOSAIC)
            <keyword>$KEYWORD$</keyword>
            $END_FOR
            <description>
                $WRAP(16,91,MOSAIC_DESCRIPTION,preserve_single_newlines=False)$
            </description>
        </Citation_Information>
        <Modification_History>
            <Modification_Detail>
                <modification_date>$CURRENT_DATE$</modification_date>
                <version_id>1.0</version_id>
                <description>Initial version.</description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>
    <Observation_Area>
        <comment>
            $WRAP(12,91,MOSAIC_COMMENT,preserve_single_newlines=False)$
        </comment>
        <Time_Coordinates>
            <start_date_time>$START_DATE_TIME$</start_date_time>
            <stop_date_time>$STOP_DATE_TIME$</stop_date_time>
        </Time_Coordinates>
        <Primary_Result_Summary>
            <purpose>Science</purpose>
            <processing_level>Derived</processing_level>
            <Science_Facets>
                <wavelength_range>Visible</wavelength_range>
                <discipline_name>Ring-Moon Systems</discipline_name>
            </Science_Facets>
        </Primary_Result_Summary>
        <Investigation_Area>
            <name>Cassini-Huygens</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:investigation:mission.cassini-huygens</lid_reference>
                <reference_type>data_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>
        <Observing_System>
            <name>Cassini Imaging Science Subsystem - $CAMERA_WIDTH$ Angle Camera</name>
            <Observing_System_Component>
                <name>Cassini Orbiter</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument_host:spacecraft.co</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
            <Observing_System_Component>
                <name>Imaging Science Subsystem - $CAMERA_WIDTH$ Angle</name>
                <type>Instrument</type>
                <description>ISS$CAMERA_WN_UC$A</description>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument:iss$CAMERA_WN_LC$a.co</lid_reference>
                    <reference_type>is_instrument</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
        </Observing_System>
        <Target_Identification>
            <name>F Ring of Saturn</name>
            <type>Ring</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:target:ring.saturn.f_ring</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>
        <Target_Identification>
            <name>Saturn Rings</name>
            <type>Ring</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:target:ring.saturn.rings</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>$NOESCAPE(TARGET_IDENTIFICATION)$
        <Mission_Area>
            <cassini:Cassini>
                <cassini:ISS_Specific_Attributes>
                    <cassini:mission_phase_name>$TOUR$</cassini:mission_phase_name>
                    <cassini:spacecraft_clock_count_partition>$SPACECRAFT_CLOCK_CNT_PARTITION$</cassini:spacecraft_clock_count_partition>
                    <cassini:spacecraft_clock_start_count>$SPACECRAFT_CLOCK_START_COUNT$</cassini:spacecraft_clock_start_count>
                    <cassini:spacecraft_clock_stop_count>$SPACECRAFT_CLOCK_STOP_COUNT$</cassini:spacecraft_clock_stop_count>
                    <cassini:filter_name_1>$FILTER1$</cassini:filter_name_1>
                    <cassini:filter_name_2>$FILTER2$</cassini:filter_name_2>
                    <cassini:observation_id>$OBSERVATION_ID$</cassini:observation_id>
                </cassini:ISS_Specific_Attributes>
            </cassini:Cassini>
        </Mission_Area>
        <Discipline_Area>
            <disp:Display_Settings>
                <Local_Internal_Reference>
                    <local_identifier_reference>mosaic</local_identifier_reference>
                    <local_reference_type>display_settings_to_array</local_reference_type>
                </Local_Internal_Reference>
                <disp:Display_Direction>
                    <disp:horizontal_display_axis>Sample</disp:horizontal_display_axis>
                    <disp:horizontal_display_direction>Left to Right</disp:horizontal_display_direction>
                    <disp:vertical_display_axis>Line</disp:vertical_display_axis>
                    <disp:vertical_display_direction>Bottom to Top</disp:vertical_display_direction>
                </disp:Display_Direction>
            </disp:Display_Settings>
            <rings:Ring_Moon_Systems>
                <rings:Ring_Reprojection>
                    <Local_Internal_Reference>
                        <local_identifier_reference>mosaic</local_identifier_reference>
                        <local_reference_type>reprojection_to_array</local_reference_type>
                    </Local_Internal_Reference>
                    <rings:Reprojection_Geometry>
                        <local_identifier>reproj_geom</local_identifier>
                        <rings:description>
                            $WRAP(28,91,MOSAIC_RINGS_DESCRIPTION,preserve_single_newlines=False)$
                        </rings:description>
                        <rings:epoch_reprojection_basis_utc>2007-01-01T00:00:00.000Z</rings:epoch_reprojection_basis_utc>
                        <rings:reprojection_plane>Equator</rings:reprojection_plane>
                        <rings:corotating_flag>Y</rings:corotating_flag>
                        <rings:corotation_rate unit="deg/s">0.006735694444</rings:corotation_rate> <!-- 581.964 deg/day -->
                        <rings:mean_phase_angle unit="deg">$MEAN_PHASE_ANGLE$</rings:mean_phase_angle>
                        <rings:minimum_phase_angle unit="deg">$MIN_PHASE_ANGLE$</rings:minimum_phase_angle>
                        <rings:maximum_phase_angle unit="deg">$MAX_PHASE_ANGLE$</rings:maximum_phase_angle>
                        <rings:mean_incidence_angle unit="deg">$MEAN_INCIDENCE_ANGLE$</rings:mean_incidence_angle>
                        <rings:minimum_incidence_angle unit="deg">$MEAN_INCIDENCE_ANGLE$</rings:minimum_incidence_angle>
                        <rings:maximum_incidence_angle unit="deg">$MEAN_INCIDENCE_ANGLE$</rings:maximum_incidence_angle>
                        <rings:mean_emission_angle unit="deg">$MEAN_EMISSION_ANGLE$</rings:mean_emission_angle>
                        <rings:minimum_emission_angle unit="deg">$MIN_EMISSION_ANGLE$</rings:minimum_emission_angle>
                        <rings:maximum_emission_angle unit="deg">$MAX_EMISSION_ANGLE$</rings:maximum_emission_angle>
                        <rings:minimum_corotating_ring_longitude unit="deg">$MIN_RING_COROTATING_LONG$</rings:minimum_corotating_ring_longitude>
                        <rings:maximum_corotating_ring_longitude unit="deg">$MAX_RING_COROTATING_LONG$</rings:maximum_corotating_ring_longitude>
                        <rings:minimum_ring_radius unit="km">$MIN_RING_RADIUS$</rings:minimum_ring_radius>
                        <rings:maximum_ring_radius unit="km">$MAX_RING_RADIUS$</rings:maximum_ring_radius>
                        <rings:Reprojection_Grid_Parameters>
                            <local_identifier>reproj_grid</local_identifier>
                            <rings:reprojection_grid_radial_sampling_interval unit="km">5.0</rings:reprojection_grid_radial_sampling_interval>
                            <rings:reprojection_grid_longitudinal_sampling_interval unit="deg">0.02</rings:reprojection_grid_longitudinal_sampling_interval>
                            <rings:minimum_radial_resolution unit="km">$MIN_REPROJ_GRID_RAD_RES$</rings:minimum_radial_resolution>
                            <rings:maximum_radial_resolution unit="km">$MAX_REPROJ_GRID_RAD_RES$</rings:maximum_radial_resolution>
                            <rings:mean_radial_resolution unit="km">$MEAN_REPROJ_GRID_RAD_RES$</rings:mean_radial_resolution>
                            <rings:minimum_longitudinal_resolution unit="deg">$MIN_REPROJ_GRID_ANG_RES$</rings:minimum_longitudinal_resolution>
                            <rings:maximum_longitudinal_resolution unit="deg">$MAX_REPROJ_GRID_ANG_RES$</rings:maximum_longitudinal_resolution>
                            <rings:mean_longitudinal_resolution unit="deg">$MEAN_REPROJ_GRID_ANG_RES$</rings:mean_longitudinal_resolution>
                        </rings:Reprojection_Grid_Parameters>
                    </rings:Reprojection_Geometry>
                </rings:Ring_Reprojection>
            </rings:Ring_Moon_Systems>
        </Discipline_Area>
    </Observation_Area>
    <Reference_List>
        <Internal_Reference>
            <lid_reference>$USERGUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>
                $WRAP(16,91,USERGUIDE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$CASSINI_USER_GUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>$CASSINI_USER_GUIDE_DESC$</comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$MOSAIC_OTHER_LID$</lid_reference>
            <reference_type>data_to_derived_product</reference_type>
            <comment>
                $WRAP(16,91,MOSAIC_OTHER_REFERENCE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$BROWSE_MOSAIC_LID$</lid_reference>
            <reference_type>data_to_browse</reference_type>
            <comment>
                $WRAP(16,91,BROWSE_MOSAIC_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
    </Reference_List>
    <File_Area_Observational>
        <File>
            <file_name>$MOSAIC_IMG_FILENAME$</file_name>
            <creation_date_time>$FILE_ZULU(IMG_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(IMG_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(IMG_PATH)$</md5_checksum>
        </File>
        <!-- The mosaic -->
        <Array_2D_Image>
            <local_identifier>mosaic</local_identifier>
            <offset unit="byte">0</offset>
            <axes>2</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>
                Line is the radial axis and Sample is the co-rotating longitude axis.
                Line 0 is the innermost row, at a delta radius of -1000 km from the
                F ring core, and the delta radius increases outward by 5 km per line,
                so that delta radius = -1000 + 5 * Line km and the modeled core lies
                at Line 200. Sample 0 is co-rotating longitude 0 degrees and the
                longitude increases by 0.02 degrees per sample, so that longitude =
                0.02 * Sample degrees.
            </description>
            <Element_Array>
                <data_type>IEEE754LSBSingle</data_type>
                <unit>I/F</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Line</axis_name> <!-- vertical (delta radius) -->
                <elements>$IMG_NUM_LINES$</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name> <!-- horizontal (co-rotating longitude) -->
                <elements>$IMG_NUM_SAMPLES$</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Special_Constants>
                <!-- $SENTINEL_DESCRIPTION$ -->
                <missing_constant>$SENTINEL$</missing_constant>
            </Special_Constants>
        </Array_2D_Image>
    </File_Area_Observational>
    <File_Area_Observational_Supplemental>
        <File>
            <file_name>$IMAGE_TABLE_FILENAME$</file_name>
            <creation_date_time>$FILE_ZULU(IMAGE_TABLE_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(IMAGE_TABLE_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(IMAGE_TABLE_PATH)$</md5_checksum>
        </File>
        <Header>
            <offset unit="byte">0</offset>
            <object_length unit="byte">19</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>image_index,LIDVID</description>
        </Header>
        <Table_Character>
            <local_identifier>image_table</local_identifier>
            <offset unit="byte">19</offset>
            <records>$FILE_RECORDS(IMAGE_TABLE_PATH)-1$</records>
            <description>Source image indices and associated LIDVIDs</description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>2</fields>
                <groups>0</groups>
                <record_length unit="byte">102</record_length>
                <Field_Character>
                    <name>image_index</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_NonNegative_Integer</data_type>
                    <field_length unit="byte">4</field_length>
                    <description>
                        The index number specific to this mosaic for the source image.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>LIDVID</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">7</field_location>
                    <data_type>ASCII_LIDVID</data_type>
                    <field_length unit="byte">95</field_length>
                    <description>LIDVID for the source image.</description>
                </Field_Character>
            </Record_Character>
        </Table_Character>
    </File_Area_Observational_Supplemental>
    <File_Area_Observational_Supplemental>
        <File>
            <file_name>$METADATA_PARAMS_TABLE_FILENAME$</file_name>
            <creation_date_time>$FILE_ZULU(METADATA_PARAMS_TABLE_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(METADATA_PARAMS_TABLE_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(METADATA_PARAMS_TABLE_PATH)$</md5_checksum>
        </File>
        <Header>
            <offset unit="byte">0</offset>
            <object_length unit="byte">379</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>
                rings:corotating_ring_longitude,image_index,
                rings:observed_event_tdb,
                rings:inertial_ring_longitude,
                rings:radial_resolution,rings:longitudinal_resolution,
                rings:incidence_angle,rings:phase_angle,rings:emission_angle,
                core_radius,longitude_ascending_node,longitude_pericenter,true_anomaly,
                corotating_longitude_prometheus,radius_prometheus,
                corotating_longitude_pandora,radius_pandora
            </description>
        </Header>
        <Table_Character>
            <local_identifier>metadata_params</local_identifier>
            <offset unit="byte">379</offset>
            <records>$FILE_RECORDS(METADATA_PARAMS_TABLE_PATH)-1$</records>
            <description>
                The metadata for each longitude in the mosaic that contains valid data.
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>17</fields>
                <groups>0</groups>
                <record_length unit="byte">165</record_length>
                <Field_Character>
                    <name>rings:corotating_ring_longitude</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <unit>deg</unit>
                    <description>
                        The corotating longitude, defined so that zero corotating longitude is equal to
                        zero inertial longitude at the epoch 2007-01-01T00:00:00Z.
                        COROT = (INERTIAL - 581.964 [deg/day] * (TIME [sec] - EPOCH)/86400) % 360
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>image_index</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">9</field_location>
                    <data_type>ASCII_NonNegative_Integer</data_type>
                    <field_length unit="byte">4</field_length>
                    <unit>none</unit>
                    <description>
                        The index of the source image, as listed in
                        $IMAGE_TABLE_FILENAME$, that
                        provided data for this corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:observed_event_tdb</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">15</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">13</field_length>
                    <unit>s</unit>
                    <description>
                        The Ephemeris Time, defined as the number of seconds since the J2000 epoch,
                        for the middle of the exposure of the source image that provided data for
                        this corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:inertial_ring_longitude</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">30</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The inertial longitude in the given source image that provided data for
                        this corotating longitude. This is equivalent to
                        INERTIAL = (COROT + 581.964 [deg/day] * (TIME [sec] - EPOCH)/86400) % 360
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:radial_resolution</name>
                    <field_number>5</field_number>
                    <field_location unit="byte">39</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">8</field_length>
                    <unit>km/pixel</unit>
                    <description>
                        The resolution in the radial direction for image data at this corotating
                        longitude. This information is taken from the given reprojected source
                        image.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:longitudinal_resolution</name>
                    <field_number>6</field_number>
                    <field_location unit="byte">49</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">8</field_length>
                    <unit>deg/pixel</unit>
                    <description>
                        The angular resolution in the longitude direction for image data at this
                        corotating longitude. This information is taken from the given reprojected
                        source image.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:incidence_angle</name>
                    <field_number>7</field_number>
                    <field_location unit="byte">59</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The incidence angle for Saturn's ring plane during the times the
                        images constituting this mosaic were taken. This field will be the same
                        for all corotating longitudes within a single mosaic. Due to the extremely
                        slow rate of change of the incidence angle, we do not compute a separate
                        incidence angle for each corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:phase_angle</name>
                    <field_number>8</field_number>
                    <field_location unit="byte">68</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The phase angle at this corotating longitude. This information is taken
                        from the given reprojected source image.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:emission_angle</name>
                    <field_number>9</field_number>
                    <field_location unit="byte">77</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The emission angle at this corotating longitude. This information is
                        taken from the given reprojected source image.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>core_radius</name>
                    <field_number>10</field_number>
                    <field_location unit="byte">86</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>
                        The F ring core radius from the elliptic model at the tabulated corotating
                        longitude and exposure mid-time, using a=140221.3 km, e=0.00235,
                        long_peri at J2000 = 24.2 deg, and pericenter precession rate =
                        2.70025 deg/day.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>longitude_ascending_node</name>
                    <field_number>11</field_number>
                    <field_location unit="byte">98</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The longitude of the ascending node for the F ring at the tabulated
                        exposure mid-time. This field will be the same for all corotating
                        longitudes from a single image. This value is computed assuming Omega
                        at J2000 epoch = 15.0 deg and Omega regression rate = -2.68778 deg/day.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>longitude_pericenter</name>
                    <field_number>12</field_number>
                    <field_location unit="byte">107</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The longitude of pericenter for the F ring at the tabulated
                        exposure mid-time. This field will be the same for all corotating
                        longitudes from a single image. This value is computed assuming
                        longitude_pericenter at J2000 epoch = 24.2 deg and pericenter precession
                        rate = 2.70025 deg/day.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>true_anomaly</name>
                    <field_number>13</field_number>
                    <field_location unit="byte">116</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        True anomaly = (inertial_longitude - longitude_pericenter) % 360 at the
                        tabulated exposure mid-time.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>corotating_longitude_prometheus</name>
                    <field_number>14</field_number>
                    <field_location unit="byte">125</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The corotating longitude (in the F ring reference frame) of Prometheus
                        at the tabulated exposure mid-time. This field will be the same for all
                        corotating longitudes from a single image. This value is computed using
                        the sat393.bsp SPICE kernel.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>radius_prometheus</name>
                    <field_number>15</field_number>
                    <field_location unit="byte">134</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>
                        The radius (absolute distance from Saturn's center) of Prometheus at
                        the tabulated exposure mid-time. This field will be the same for all
