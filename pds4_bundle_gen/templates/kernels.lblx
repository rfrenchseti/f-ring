<?xml-model href="$PDS4_PDS_SCHEMA$"
    schematypens="http://purl.oclc.org/dsdl/schematron"?>

<Product_SPICE_Kernel
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pds.nasa.gov/pds4/pds/v1 $PDS4_PDS_SCHEMA_XSD$">
    <Identification_Area>
        <logical_identifier>$KERNELS_LID$</logical_identifier>
        <version_id>1.0</version_id>
        <title>Metakernel</title>
        <information_model_version>$INFORMATION_MODEL_VERSION$</information_model_version>
        <product_class>Product_SPICE_Kernel</product_class>
        <Citation_Information>
            <publication_year>$PUBLICATION_YEAR$</publication_year>
            $FOR(KEYWORD=KEYWORDS)
            <keyword>$KEYWORD$</keyword>
            $END_FOR
            <keyword>observation geometry</keyword>
            <keyword>SPICE</keyword>
            <description>
                SPICE metakernel file, kernels.ker, defining all kernels used to create the F ring
                mosaics and associated reprojected versions of Cassini ISS calibrated images in
                this bundle.
            </description>
        </Citation_Information>
        <Modification_History>
            <Modification_Detail>
                <modification_date>$CURRENT_ZULU(date_only=True)$</modification_date>
                <version_id>1.0</version_id>
                <description>Initial version.</description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>
    <Context_Area>
        <Time_Coordinates>
            <start_date_time xsi:nil="true" nilReason="inapplicable"></start_date_time>
            <stop_date_time xsi:nil="true" nilReason="inapplicable"></stop_date_time>
        </Time_Coordinates>
        <Primary_Result_Summary>
            <purpose>Observation Geometry</purpose>
            <processing_level>Derived</processing_level>
            <description>
                SPICE metakernel file, kernels.ker, defining all kernels used to create the F ring
                mosaics and associated reprojected versions of Cassini ISS calibrated images in
                this bundle.
            </description>
        </Primary_Result_Summary>
        <Investigation_Area>
            <name>Cassini-Huygens</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:investigation:mission.cassini-huygens</lid_reference>
                <reference_type>collection_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>
        <Observing_System>
            <name>Cassini Orbiter Imaging Science Subsystem - Wide Angle Camera</name>
            <Observing_System_Component>
                <name>Cassini Orbiter</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument_host:spacecraft.co</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
            <Observing_System_Component>
                <name>Imaging Science Subsystem - Wide Angle</name>
                <type>Instrument</type>
                <description>ISSWA</description>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument:isswa.co</lid_reference>
                    <reference_type>is_instrument</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
        </Observing_System>
        <Target_Identification>
            <name>F Ring of Saturn</name>
            <type>Ring</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:target:ring.saturn.f_ring</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>
        <Target_Identification>
            <name>Saturn Rings</name>
            <type>Ring</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:target:ring.saturn.rings</lid_reference>
                <reference_type>data_to_target</reference_type>
            </Internal_Reference>
        </Target_Identification>
    </Context_Area>
    <Reference_List>
        <Internal_Reference>
            <lid_reference>$USERGUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>
                Detailed User's Guide for the F Ring Mosaics and Reprojected Images in this
                bundle.
            </comment>
        </Internal_Reference>
        <External_Reference>
            <reference_text>
                URL: https://naif.jpl.nasa.gov/naif/documentation.html
                At the time of archiving, NAIF (Navigation and Ancillary Information) Node
                of NASA PDS provides extensive documentation of SPICE, via the URL given
                above. For example, "C-Kernel Required Reading" documentation describing
                C-Matrices is accessed via
                https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/C/req/ck.html#C-Matrices
                Note that the HTML Toolkit Documents are provided in various programming
                languages (the example above is for C).
            </reference_text>
            <description>NAIF HTML documentation describing SPICE</description>
        </External_Reference>
    </Reference_List>
    <File_Area_SPICE_Kernel>
        <File>
            <file_name>$KERNELS_NAME$</file_name>
            <creation_date_time>$FILE_ZULU(KERNELS_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(KERNELS_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(KERNELS_PATH)$</md5_checksum>
        </File>
        <SPICE_Kernel>
            <offset unit="byte">0</offset>
            <object_length unit="byte">$FILE_BYTES(KERNELS_PATH)$</object_length>
            <parsing_standard_id>SPICE</parsing_standard_id>
            <description>
                SPICE metakernel file, kernels.ker, defining all kernels used to create the F ring
                mosaics and associated reprojected versions of Cassini ISS calibrated images in
                this bundle.
            </description>
            <kernel_type>MK</kernel_type>
            <encoding_type>Character</encoding_type>
        </SPICE_Kernel>
    </File_Area_SPICE_Kernel>
</Product_SPICE_Kernel>
