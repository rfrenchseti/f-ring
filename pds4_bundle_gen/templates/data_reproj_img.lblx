                    <cassini:calibration_lamp_state_flag>$CALIBRATION_LAMP_STATE_FLAG$</cassini:calibration_lamp_state_flag>
                    <cassini:command_file_name>$COMMAND_FILE_NAME$</cassini:command_file_name>
                    <cassini:command_sequence_number>$COMMAND_SEQUENCE_NUMBER$</cassini:command_sequence_number>
                    <cassini:dark_strip_mean>$DARK_STRIP_MEAN$</cassini:dark_strip_mean>
                    <cassini:data_conversion_type>$DATA_CONVERSION_TYPE$</cassini:data_conversion_type>
                    <cassini:delayed_readout_flag>$DELAYED_READOUT_FLAG$</cassini:delayed_readout_flag>
                    <cassini:detector_temperature unit="degC">$DETECTOR_TEMPERATURE$</cassini:detector_temperature>
                    <cassini:electronics_bias>$ELECTRONICS_BIAS$</cassini:electronics_bias>
                    <cassini:earth_received_start_time>$EARTH_RECEIVED_START_TIME$</cassini:earth_received_start_time>
                    <cassini:earth_received_stop_time>$EARTH_RECEIVED_STOP_TIME$</cassini:earth_received_stop_time>
                    <cassini:expected_maximum_full_well>$EXPECTED_MAXIMUM[0]$</cassini:expected_maximum_full_well>
                    <cassini:expected_maximum_DN_sat>$EXPECTED_MAXIMUM[1]$</cassini:expected_maximum_DN_sat>
                    <cassini:expected_packets>$EXPECTED_PACKETS$</cassini:expected_packets>
                    <cassini:exposure_duration unit="ms">$EXPOSURE_DURATION$</cassini:exposure_duration>
                    <cassini:filter_name_1>$FILTER1$</cassini:filter_name_1>
                    <cassini:filter_name_2>$FILTER2$</cassini:filter_name_2>
                    <cassini:filter_temperature unit="degC">$FILTER_TEMPERATURE$</cassini:filter_temperature>
                    <cassini:flight_software_version_id>$FLIGHT_SOFTWARE_VERSION_ID$</cassini:flight_software_version_id>
                    <cassini:gain_mode_id unit="electron/DN">$GAIN_MODE_ID$</cassini:gain_mode_id>
                    <cassini:ground_software_version_id>$SOFTWARE_VERSION_ID$</cassini:ground_software_version_id>
                    <cassini:image_mid_time>$IMAGE_MID_TIME$</cassini:image_mid_time>
                    <cassini:image_number>$IMAGE_NUMBER$</cassini:image_number>
                    <cassini:image_time>$IMAGE_TIME$</cassini:image_time>
                    $NOESCAPE(IMAGE_OBSERVATION_TYPE)$
                    <cassini:instrument_data_rate>$INSTRUMENT_DATA_RATE$</cassini:instrument_data_rate>
                    <cassini:instrument_mode_id>$INSTRUMENT_MODE_ID$</cassini:instrument_mode_id>
                    <cassini:inst_cmprs_type>$INST_CMPRS_TYPE$</cassini:inst_cmprs_type>
                    <cassini:inst_cmprs_rate_expected_bits>$INST_CMPRS_RATE[0]$</cassini:inst_cmprs_rate_expected_bits>
                    <cassini:inst_cmprs_rate_actual_bits>$INST_CMPRS_RATE[1]$</cassini:inst_cmprs_rate_actual_bits>
                    <cassini:inst_cmprs_ratio>$INST_CMPRS_RATIO$</cassini:inst_cmprs_ratio>
                    <cassini:light_flood_state_flag>$LIGHT_FLOOD_STATE_FLAG$</cassini:light_flood_state_flag>
                    <cassini:method_description>$METHOD_DESC$</cassini:method_description>
                    <cassini:missing_lines>$MISSING_LINES$</cassini:missing_lines>$NOESCAPE(MISSING_LINES_COMMENT)$
                    <cassini:missing_packet_flag>$MISSING_PACKET_FLAG$</cassini:missing_packet_flag>
                    <cassini:observation_id>$OBSERVATION_ID$</cassini:observation_id>
                    <cassini:optics_temperature_front unit="degC">$OPTICS_TEMPERATURE[0]$</cassini:optics_temperature_front>
                    <cassini:optics_temperature_back unit="degC">$OPTICS_TEMPERATURE[1]$</cassini:optics_temperature_back>
                    <cassini:order_number>$ORDER_NUMBER$</cassini:order_number>
                    <cassini:parallel_clock_voltage_index>$PARALLEL_CLOCK_VOLTAGE_INDEX$</cassini:parallel_clock_voltage_index>
                    <cassini:pds3_target_desc>$TARGET_DESC$</cassini:pds3_target_desc>
                    <cassini:prepare_cycle_index>$PREPARE_CYCLE_INDEX$</cassini:prepare_cycle_index>
                    <cassini:readout_cycle_index>$READOUT_CYCLE_INDEX$</cassini:readout_cycle_index>
                    <cassini:received_packets>$RECEIVED_PACKETS$</cassini:received_packets>
                    <cassini:sensor_head_electronics_temperature unit="degC">$SENSOR_HEAD_ELEC_TEMPERATURE$</cassini:sensor_head_electronics_temperature>
                    <cassini:sequence_id>$SEQUENCE_ID$</cassini:sequence_id>
                    <cassini:sequence_number>$SEQUENCE_NUMBER$</cassini:sequence_number>
                    <cassini:sequence_title>$SEQUENCE_TITLE$</cassini:sequence_title>
                    <cassini:shutter_mode_id>$SHUTTER_MODE_ID$</cassini:shutter_mode_id>
                    <cassini:shutter_state_id>$SHUTTER_STATE_ID$</cassini:shutter_state_id>
                    <cassini:start_time_doy>$START_TIME_DOY$</cassini:start_time_doy>
                    <cassini:stop_time_doy>$STOP_TIME_DOY$</cassini:stop_time_doy>
                    <cassini:telemetry_format_id>$TELEMETRY_FORMAT_ID$</cassini:telemetry_format_id>
                    <cassini:valid_maximum_full_well>$VALID_MAXIMUM[0]$</cassini:valid_maximum_full_well>
                    <cassini:valid_maximum_DN_sat>$VALID_MAXIMUM[1]$</cassini:valid_maximum_DN_sat>
                </cassini:ISS_Specific_Attributes>
            </cassini:Cassini>
        </Mission_Area>
        <Discipline_Area>
            <disp:Display_Settings>
                <Local_Internal_Reference>
                    <local_identifier_reference>reproj_image</local_identifier_reference>
                    <local_reference_type>display_settings_to_array</local_reference_type>
                </Local_Internal_Reference>
                <disp:Display_Direction>
                    <disp:horizontal_display_axis>Sample</disp:horizontal_display_axis>
                    <disp:horizontal_display_direction>Left to Right</disp:horizontal_display_direction>
                    <disp:vertical_display_axis>Line</disp:vertical_display_axis>
                    <disp:vertical_display_direction>Bottom to Top</disp:vertical_display_direction>
                </disp:Display_Direction>
            </disp:Display_Settings>
            <geom:Geometry>
                <geom:SPICE_Kernel_Files>
                    <geom:SPICE_Kernel_Identification>
                        <geom:kernel_type>MK</geom:kernel_type>
                        <geom:spice_kernel_file_name>kernels.ker</geom:spice_kernel_file_name>
                    </geom:SPICE_Kernel_Identification>
                    <geom:comment>
                        This metakernel file lists all SPICE kernels used in the
                        generation of the derived data products in the parent bundle. Some
                        of them may not have been used directly in the generation of this
                        product. The relevant C-kernel identified in the metakernel
                        provided initial pointing information, which has been refined and
                        is superseded by the pointing information in the C-matrix
                        described in File_Area_Observational_Supplemental below. In all
                        cases, the base coordinate frame is J2000.
                    </geom:comment>
                </geom:SPICE_Kernel_Files>
            </geom:Geometry>
            <rings:Ring_Moon_Systems>
                <rings:Ring_Reprojection>
                    <Local_Internal_Reference>
                        <local_identifier_reference>reproj_image</local_identifier_reference>
                        <local_reference_type>reprojection_to_array</local_reference_type>
                    </Local_Internal_Reference>
                    <rings:Reprojection_Geometry>
                        <local_identifier>reproj_geom</local_identifier>
                        <rings:description>
                            $WRAP(28,91,REPROJ_RINGS_DESCRIPTION,preserve_single_newlines=False)$
                        </rings:description>
                        <rings:epoch_reprojection_basis_utc>2007-01-01T00:00:00.000Z</rings:epoch_reprojection_basis_utc>
                        <rings:reprojection_plane>Equator</rings:reprojection_plane>
                        <rings:corotating_flag>Y</rings:corotating_flag>
                        <rings:corotation_rate unit="deg/s">0.006735694444</rings:corotation_rate> <!-- 581.964 deg/day -->
                        <rings:mean_phase_angle unit="deg">$MEAN_PHASE_ANGLE$</rings:mean_phase_angle>
                        <rings:minimum_phase_angle unit="deg">$MIN_PHASE_ANGLE$</rings:minimum_phase_angle>
                        <rings:maximum_phase_angle unit="deg">$MAX_PHASE_ANGLE$</rings:maximum_phase_angle>
                        <rings:mean_incidence_angle unit="deg">$MEAN_INCIDENCE_ANGLE$</rings:mean_incidence_angle>
                        <rings:minimum_incidence_angle unit="deg">$MEAN_INCIDENCE_ANGLE$</rings:minimum_incidence_angle>
                        <rings:maximum_incidence_angle unit="deg">$MEAN_INCIDENCE_ANGLE$</rings:maximum_incidence_angle>
                        <rings:mean_emission_angle unit="deg">$MEAN_EMISSION_ANGLE$</rings:mean_emission_angle>
                        <rings:minimum_emission_angle unit="deg">$MIN_EMISSION_ANGLE$</rings:minimum_emission_angle>
                        <rings:maximum_emission_angle unit="deg">$MAX_EMISSION_ANGLE$</rings:maximum_emission_angle>
                        <rings:minimum_corotating_ring_longitude unit="deg">$MIN_RING_COROTATING_LONG$</rings:minimum_corotating_ring_longitude>
                        <rings:maximum_corotating_ring_longitude unit="deg">$MAX_RING_COROTATING_LONG$</rings:maximum_corotating_ring_longitude>
                        <rings:minimum_ring_radius unit="km">$MIN_RING_RADIUS$</rings:minimum_ring_radius>
                        <rings:maximum_ring_radius unit="km">$MAX_RING_RADIUS$</rings:maximum_ring_radius>
                        <rings:Reprojection_Grid_Parameters>
                            <local_identifier>reproj_grid</local_identifier>
                            <rings:reprojection_grid_radial_sampling_interval unit="km">5.0</rings:reprojection_grid_radial_sampling_interval>
                            <rings:reprojection_grid_longitudinal_sampling_interval unit="deg">0.02</rings:reprojection_grid_longitudinal_sampling_interval>
                            <rings:minimum_radial_resolution unit="km">$MIN_REPROJ_GRID_RAD_RES$</rings:minimum_radial_resolution>
                            <rings:maximum_radial_resolution unit="km">$MAX_REPROJ_GRID_RAD_RES$</rings:maximum_radial_resolution>
                            <rings:mean_radial_resolution unit="km">$MEAN_REPROJ_GRID_RAD_RES$</rings:mean_radial_resolution>
                            <rings:minimum_longitudinal_resolution unit="deg">$MIN_REPROJ_GRID_ANG_RES$</rings:minimum_longitudinal_resolution>
                            <rings:maximum_longitudinal_resolution unit="deg">$MAX_REPROJ_GRID_ANG_RES$</rings:maximum_longitudinal_resolution>
                            <rings:mean_longitudinal_resolution unit="deg">$MEAN_REPROJ_GRID_ANG_RES$</rings:mean_longitudinal_resolution>
                        </rings:Reprojection_Grid_Parameters>
                    </rings:Reprojection_Geometry>
                </rings:Ring_Reprojection>
            </rings:Ring_Moon_Systems>
        </Discipline_Area>
    </Observation_Area>
    <Reference_List>
        <Internal_Reference>
            <lid_reference>$USERGUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>
                $WRAP(16,91,USERGUIDE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$CASSINI_USER_GUIDE_LID$</lid_reference>
            <reference_type>data_to_document</reference_type>
            <comment>$CASSINI_USER_GUIDE_DESC$</comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$MOSAIC_LID$</lid_reference>
            <reference_type>data_to_derived_product</reference_type>
            <comment>
                $WRAP(16,91,MOSAIC_REFERENCE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$MOSAIC_OTHER_LID$</lid_reference>
            <reference_type>data_to_derived_product</reference_type>
            <comment>
                $WRAP(16,91,MOSAIC_OTHER_REFERENCE_COMMENT,preserve_single_newlines=False)$
            </comment>
        </Internal_Reference>
        <Internal_Reference>
            <lid_reference>$BROWSE_REPROJ_LID$</lid_reference>
            <reference_type>data_to_browse</reference_type>
            <comment>
                The browse images of the reprojected image in multiple sizes in PNG format.
            </comment>
        </Internal_Reference>
        <External_Reference>
            <reference_text>
                URL: https://naif.jpl.nasa.gov/naif/documentation.html
                At the time of archiving, NAIF (Navigation and Ancillary Information) Node
                of NASA PDS provides extensive documentation of SPICE, via the URL given
                above. For example, "C-Kernel Required Reading" documentation describing
                C-Matrices is accessed via
                https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/C/req/ck.html#C-Matrices
                Note that the HTML Toolkit Documents are provided in various programming
                languages (the example above is for C).
            </reference_text>
            <description>NAIF HTML documentation describing SPICE</description>
        </External_Reference>
        <Source_Product_Internal>
            <lidvid_reference>$CALIB_LIDVID$</lidvid_reference>
            <reference_type>data_to_calibrated_source_product</reference_type>
        </Source_Product_Internal>
    </Reference_List>
    <File_Area_Observational>
        <File>
            <file_name>$REPROJ_IMG_FILENAME$</file_name>
            <creation_date_time>$FILE_ZULU(IMG_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(IMG_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(IMG_PATH)$</md5_checksum>
        </File>
        <!-- The calibrated, reprojected single image -->
        <Array_2D_Image>
            <local_identifier>reproj_image</local_identifier>
            <offset unit="byte">0</offset>
            <axes>2</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>
                Line is the radial axis and Sample is the co-rotating longitude axis.
                Line 0 is the innermost row, at a delta radius of -1000 km from the
                F ring core, and the delta radius increases outward by 5 km per line,
                so that delta radius = -1000 + 5 * Line km and the modeled core lies
                at Line 200. Sample 0 is the minimum co-rotating longitude given by
                rings:minimum_corotating_ring_longitude and the longitude increases
                by 0.02 degrees per sample, wrapping through 360 degrees when the
                minimum is greater than the maximum.
            </description>
            <Element_Array>
                <data_type>IEEE754LSBSingle</data_type>
                <unit>I/F</unit>
            </Element_Array>
            <Axis_Array>
                <axis_name>Line</axis_name> <!-- vertical (delta radius) -->
                <elements>$IMG_NUM_LINES$</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name> <!-- horizontal (co-rotating longitude) -->
                <elements>$IMG_NUM_SAMPLES$</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Special_Constants>
                <!-- Data was missing or corrupted in the original image (either because it was off
                 the edge of the FOV or because of a transmission error resulting in a partial or
                 corrupted image) -->
                <missing_constant>$SENTINEL$</missing_constant>
            </Special_Constants>
        </Array_2D_Image>
    </File_Area_Observational>
    <File_Area_Observational_Supplemental>
        <!-- Supplemental file containing SPICE pointing information and relevant parameters -->
        <File>
            <file_name>$REPROJ_IMG_SUPPL_FILENAME$</file_name>
            <local_identifier>c-matrix</local_identifier>
            <creation_date_time>$FILE_ZULU(SUPPL_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(SUPPL_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(SUPPL_PATH)$</md5_checksum>
            <comment>
                This file contains improved camera pointing in the form of a C-matrix
                rotation from the J2000 reference frame to the camera frame. The
                refinement results from the analysis of contents of the image coupled with
                initial pointing information provided by the relevant C-kernel (listed in
                the metakernel referenced above).
            </comment>
        </File>
        <Header>
            <offset unit="byte">0</offset>
            <object_length unit="byte">$SUPPL_HEADER_LENGTH$</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>Header containing parameters relevant to SPICE camera pointing information</description>
        </Header>
        <Table_Character>
            <local_identifier>supplemental_info</local_identifier>
            <offset unit="byte">$SUPPL_HEADER_LENGTH$</offset>
            <records>3</records>
            <description>This is a supplemental table containing C-matrix pointing information and relevant parameters.</description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>3</fields>
                <groups>0</groups>
                <record_length unit="byte">49</record_length>
                <Field_Character>
                    <name>C-matrix first column</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">16</field_length>
                </Field_Character>
                <Field_Character>
                    <name>C-matrix second column</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">17</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">16</field_length>
                </Field_Character>
                <Field_Character>
                    <name>C-matrix third column</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">33</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">16</field_length>
                </Field_Character>
            </Record_Character>
        </Table_Character>
    </File_Area_Observational_Supplemental>
    <File_Area_Observational_Supplemental>
        <File>
            <file_name>$METADATA_PARAMS_TABLE_FILENAME$</file_name>
            <creation_date_time>$FILE_ZULU(METADATA_PARAMS_TABLE_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(METADATA_PARAMS_TABLE_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(METADATA_PARAMS_TABLE_PATH)$</md5_checksum>
        </File>
        <Header>
            <offset unit="byte">0</offset>
            <object_length unit="byte">367</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>
                rings:corotating_ring_longitude,
                rings:observed_event_tdb,
                rings:inertial_ring_longitude,
                rings:radial_resolution,rings:longitudinal_resolution,
                rings:incidence_angle,rings:phase_angle,rings:emission_angle,
                core_radius,longitude_ascending_node,longitude_pericenter,true_anomaly,
                corotating_longitude_prometheus,radius_prometheus,
                corotating_longitude_pandora,radius_pandora
            </description>
        </Header>
        <Table_Character>
            <local_identifier>metadata_params</local_identifier>
            <offset unit="byte">367</offset>
            <records>$FILE_RECORDS(METADATA_PARAMS_TABLE_PATH)-1$</records>
            <description>
                The metadata for each longitude in the reprojected image that contains valid data.
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>16</fields>
                <groups>0</groups>
                <record_length unit="byte">159</record_length>
                <Field_Character>
                    <name>rings:corotating_ring_longitude</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <unit>deg</unit>
                    <description>
                        The corotating longitude, defined so that zero corotating longitude is equal to
                        zero inertial longitude at the epoch 2007-01-01T00:00:00Z.
                        COROT = (INERTIAL - 581.964 [deg/day] * (TIME [sec] - EPOCH)/86400) % 360
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:observed_event_tdb</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">9</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">13</field_length>
                    <unit>s</unit>
                    <description>
                        The Ephemeris Time, defined as the number of seconds since the J2000 epoch,
                        at middle of the exposure for this image. This field will be the same for
                        all corotating longitudes within a single image and is provided here for
                        convenience.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:inertial_ring_longitude</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">24</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The inertial longitude that provided data for this corotating longitude.
                        This is equivalent to
                        INERTIAL = (COROT + 581.964 [deg/day] * (TIME [sec] - EPOCH)/86400) % 360
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:radial_resolution</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">33</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">8</field_length>
                    <unit>km/pixel</unit>
                    <description>
                        The mean resolution in the radial direction for image data at this
                        corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:longitudinal_resolution</name>
                    <field_number>5</field_number>
                    <field_location unit="byte">43</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">8</field_length>
                    <unit>deg/pixel</unit>
                    <description>
                        The mean angular resolution in the longitude direction for image data
                        at this corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:incidence_angle</name>
                    <field_number>6</field_number>
                    <field_location unit="byte">53</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The incidence angle for Saturn's ring plane at the time this image
                        was taken. This field will be the same for all corotating longitudes within
                        a single image and is provided here for convenience.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:phase_angle</name>
                    <field_number>7</field_number>
                    <field_location unit="byte">62</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The mean phase angle for image data at this corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>rings:emission_angle</name>
                    <field_number>8</field_number>
                    <field_location unit="byte">71</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The mean emission angle for image data at this corotating longitude.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>core_radius</name>
                    <field_number>9</field_number>
                    <field_location unit="byte">80</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>
                        The F ring core radius from the elliptic model at the tabulated corotating
                        longitude and exposure mid-time, using a=140221.3 km, e=0.00235,
                        long_peri at J2000 = 24.2 deg, and pericenter precession rate =
                        2.70025 deg/day.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>longitude_ascending_node</name>
                    <field_number>10</field_number>
                    <field_location unit="byte">92</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The longitude of the ascending node for the F ring at the exposure
                        mid-time. This field will be the same for all corotating longitudes within
                        a single image and is provided here for convenience. This value is computed
                        assuming Omega at J2000 epoch = 15.0 deg and Omega regression rate =
                        -2.68778 deg/day.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>longitude_pericenter</name>
                    <field_number>11</field_number>
                    <field_location unit="byte">101</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The longitude of pericenter for the F ring at the exposure mid-time.
                        This field will be the same for all corotating longitudes within
                        a single image and is provided here for convenience. This value is computed
                        assuming longitude_pericenter at J2000 epoch = 24.2 deg and pericenter
                        precession rate = 2.70025 deg/day.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>true_anomaly</name>
                    <field_number>12</field_number>
                    <field_location unit="byte">110</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        True anomaly = (inertial_longitude - long_peri) % 360 deg at exposure
                        mid-time.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>corotating_longitude_prometheus</name>
                    <field_number>13</field_number>
                    <field_location unit="byte">119</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The corotating longitude (in the F ring reference frame) of Prometheus
                        at the exposure mid-time. This field will be the same for all corotating
                        longitudes within a single image and is provided here for convenience.
                        This value is computed using the sat393.bsp SPICE kernel.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>radius_prometheus</name>
                    <field_number>14</field_number>
                    <field_location unit="byte">128</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>
                        The radius (absolute distance from Saturn's center) of Prometheus at
                        the exposure mid-time. This field will be the same for all corotating
                        longitudes within a single image and is provided here for convenience.
                        This value is computed using the sat393.bsp SPICE kernel.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>corotating_longitude_pandora</name>
                    <field_number>15</field_number>
                    <field_location unit="byte">140</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <unit>deg</unit>
                    <description>
                        The corotating longitude (in the F ring reference frame) of Pandora
                        at the exposure mid-time. This field will be the same for all corotating
                        longitudes within a single image and is provided here for convenience.
                        This value is computed using the sat393.bsp SPICE kernel.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>radius_pandora</name>
                    <field_number>16</field_number>
                    <field_location unit="byte">149</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>
                        The radius (absolute distance from Saturn's center) of Pandora at
                        the exposure mid-time. This field will be the same for all corotating
                        longitudes within a single image and is provided here for convenience.
                        This value is computed using the sat393.bsp SPICE kernel.
                    </description>
                </Field_Character>
            </Record_Character>
        </Table_Character>
    </File_Area_Observational_Supplemental>
</Product_Observational>
