                <Field_Character>
                    <name>cassini:spacecraft_clock_start_count</name>
                    <field_number>6</field_number>
                    <field_location unit="byte">293</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">14</field_length>
                    <description>
                        The spacecraft clock start count for the observation, with the
                        partition number (always 1) omitted. This is a clock reading, not
                        a number of seconds: the digits after the decimal point are
                        counts of 1/256 of a second, so that 1549801215.222 is 222/256 of
                        a second after tick 1549801215.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>cassini:spacecraft_clock_stop_count</name>
                    <field_number>7</field_number>
                    <field_location unit="byte">308</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">14</field_length>
                    <description>
                        The spacecraft clock stop count for the observation, with the
                        partition number (always 1) omitted. This is a clock reading, not
                        a number of seconds: the digits after the decimal point are
                        counts of 1/256 of a second, so that 1549801215.222 is 222/256 of
                        a second after tick 1549801215.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>num_valid_longitudes</name>
                    <field_number>8</field_number>
                    <field_location unit="byte">323</field_location>
                    <data_type>ASCII_NonNegative_Integer</data_type>
                    <field_length unit="byte">5</field_length>
                    <description>
